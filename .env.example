# CashBridge environment settings. Copy to .env and adjust.

# --- LLM (any OpenAI-compatible endpoint: OpenRouter, OpenAI, local vLLM/Ollama/LM Studio) ---
# Base URL and key are read from the environment; nothing is hardcoded in the code.
# WARNING: tool outputs (balances, receivables) are sent to this endpoint. Use the
# provider's official URL only. Do not use unknown third-party "proxy" / reseller
# endpoints: they can log or resell financial data. Third-party names are
# pseudonymised before sending, but amounts are not.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a model your provider actually lists (check its /models endpoint).
OPENROUTER_MODEL=

# Use deterministic template explanations (no LLM API calls). 1 = mock, 0 = real LLM.
MOCK_LLM=1

# --- Data ---
CASHBRIDGE_DB=cashbridge.db
# Demo clock. The three demo stories are tuned for this date (a Friday).
# Set to "today" to use the real date.
CASHBRIDGE_AS_OF=2026-11-06

# --- Security ---
# development | production. Production refuses to start without the two values below
# and turns off /api/docs and sets HSTS.
APP_ENV=development
# HMAC key for owner approval tokens (>= 32 random chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development, a per-database key file <db>.secret is created.
CASHBRIDGE_SECRET=
# Password for the demo owner account "demo" (>= 12 chars in production).
DEMO_PASSWORD=cashbridge-demo

# --- Sandbox bank limits ---
SANDBOX_MAX_PRINCIPAL=25000000
